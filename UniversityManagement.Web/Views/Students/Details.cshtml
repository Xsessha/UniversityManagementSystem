@model UniversityManagement.Core.Models.Student

<div class="student-profile">

    <div class="card shadow-lg">

        <div class="card-body">

            <div class="text-center">

                <img src="/images/students/default.png"
                     width="120"
                     class="rounded-circle mb-3"/>

                <h2>
                    @Model.FirstName @Model.LastName
                </h2>

                <p class="text-muted">
                    @Model.Email
                </p>

                <span class="badge bg-success fs-6">
                    Rating: @Model.Rating
                </span>

            </div>

        </div>

    </div>

</div>