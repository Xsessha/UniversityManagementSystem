@model UniversityManagement.Core.Models.Teacher

<div class="card shadow">

    <div class="card-body">

        <h2 class="mb-4">
            Edit Teacher
        </h2>

        <form asp-action="Edit">

            <input type="hidden"
                   asp-for="Id"/>

            <div class="mb-3">

                <label>Full Name</label>

                <input asp-for="FullName"
                       class="form-control"/>

            </div>

            <div class="mb-4">

                <label>Department</label>

                <input asp-for="Department"
                       class="form-control"/>

            </div>

            <button class="btn btn-primary">
                Save Changes
            </button>

        </form>

    </div>

</div>