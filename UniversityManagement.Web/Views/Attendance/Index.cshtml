@model IEnumerable<UniversityManagement.Core.Models.Attendance>

<div class="page-header">

    <h2>Attendance</h2>

    <a href="/Attendance/MarkAttendance"
       class="btn btn-success">
        Mark Attendance
    </a>

</div>

<div class="card shadow-sm">

    <div class="card-body">

        <table class="table table-hover">

            <thead class="table-dark">

                <tr>
                    <th>Student</th>
                    <th>Date</th>
                    <th>Status</th>
                </tr>

            </thead>

            <tbody>

            @foreach (var attendance in Model)
            {
                <tr>

                    <td>
                        @attendance.Student?.FirstName
                        @attendance.Student?.LastName
                    </td>

                    <td>
                        @attendance.Date.ToShortDateString()
                    </td>

                    <td>

                        @if (attendance.IsPresent)
                        {
                            <span class="badge bg-success">
                                Present
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-danger">
                                Absent
                            </span>
                        }

                    </td>

                </tr>
            }

            </tbody>

        </table>

    </div>

</div>