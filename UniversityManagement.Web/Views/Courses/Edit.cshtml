@model UniversityManagement.Core.Models.Course

<div class="card shadow">

    <div class="card-body">

        <h2>Edit Course</h2>

        <form asp-action="Edit">

            <input type="hidden"
                   asp-for="Id"/>

            <div class="mb-3">

                <label>Name</label>

                <input asp-for="Name"
                       class="form-control"/>

            </div>

            <div class="mb-3">

                <label>Credits</label>

                <input asp-for="Credits"
                       class="form-control"/>

            </div>

            <button class="btn btn-primary">
                Save
            </button>

        </form>

    </div>

</div>