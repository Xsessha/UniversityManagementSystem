@model UniversityManagement.Core.Models.Group

@{
    ViewData["Title"] = "Edit Group";
}

<div class="card shadow">

    <div class="card-body">

        <h2 class="mb-4">
            Edit Group
        </h2>

        <form asp-action="Edit">

            <input type="hidden"
                   asp-for="Id"/>

            <div class="mb-3">

                <label class="form-label">
                    Group Name
                </label>

                <input asp-for="Name"
                       class="form-control"/>

            </div>

            <button class="btn btn-primary">
                Save Changes
            </button>

        </form>

    </div>

</div>