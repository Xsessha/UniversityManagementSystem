@model UniversityManagement.Core.Models.Teacher

@{
    ViewData["Title"] = "Teacher Details";
}

<div class="card shadow-lg">

    <div class="card-body">

        <div class="text-center mb-4">

            <img src="/images/teachers/default.png"
                 width="120"
                 class="rounded-circle shadow"/>

            <h2 class="mt-3">
                @Model.FullName
            </h2>

            <p class="text-muted">
                @Model.Department
            </p>

        </div>

        <hr/>

        <h4 class="mb-3">
            Courses
        </h4>

        <ul class="list-group">

        @foreach (var course in Model.Courses)
        {
            <li class="list-group-item">

                @course.Name

            </li>
        }

        </ul>

    </div>

</div>