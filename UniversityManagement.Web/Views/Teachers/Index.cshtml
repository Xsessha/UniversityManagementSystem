@model IEnumerable<UniversityManagement.Core.Models.Teacher>

@{
    ViewData["Title"] = "Teachers";
}

<div class="teachers-page">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>

            <h1 class="fw-bold">
                Teachers
            </h1>

            <p class="text-muted">
                University teaching staff management
            </p>

        </div>

        <a asp-action="Create"
           class="btn btn-primary">
            Add Teacher
        </a>

    </div>

    <div class="row">

    @foreach (var teacher in Model)
    {
        <div class="col-xl-3 col-lg-4 col-md-6 mb-4">

            <div class="card teacher-card shadow-sm border-0 h-100">

                <div class="card-body text-center">

                    <img src="/images/teachers/default.png"
                         class="rounded-circle mb-3 shadow"
                         width="100"
                         height="100"/>

                    <h4 class="fw-bold">

                        @teacher.FullName

                    </h4>

                    <p class="text-muted">

                        @teacher.Department

                    </p>

                    <div class="mb-3">

                        <span class="badge bg-primary">

                            Courses:
                            @teacher.Courses.Count

                        </span>

                    </div>

                    <div class="d-grid gap-2">

                        <a asp-action="Details"
                           asp-route-id="@teacher.Id"
                           class="btn btn-outline-primary">

                            Details

                        </a>

                        <a asp-action="Edit"
                           asp-route-id="@teacher.Id"
                           class="btn btn-outline-warning">

                            Edit

                        </a>

                        <a asp-action="Delete"
                           asp-route-id="@teacher.Id"
                           class="btn btn-outline-danger">

                            Delete

                        </a>

                    </div>

                </div>

            </div>

        </div>
    }

    </div>

</div>