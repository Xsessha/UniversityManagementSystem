@model IEnumerable<UniversityManagement.Core.Models.Faculty>

@{
    ViewData["Title"] = "Faculty Report";
}

<div class="card shadow-lg">

    <div class="card-body">

        <div class="d-flex justify-content-between align-items-center mb-4">

            <h2>
                Faculty Analytics Report
            </h2>

            <button class="btn btn-danger">
                Export PDF
            </button>

        </div>

        <table class="table table-striped">

            <thead class="table-dark">

                <tr>
                    <th>Faculty</th>
                    <th>Groups</th>
                    <th>Students</th>
                    <th>Average Rating</th>
                </tr>

            </thead>

            <tbody>

            @foreach (var faculty in Model)
            {
                <tr>

                    <td>
                        @faculty.Name
                    </td>

                    <td>
                        @faculty.Groups.Count
                    </td>

                    <td>
                        @faculty.Groups.Sum(g => g.Students.Count)
                    </td>

                    <td>

                        @{
                            var average =
                                faculty.Groups
                                    .SelectMany(g => g.Students)
                                    .Average(s => s.Rating);
                        }

                        <span class="badge bg-primary">
                            @average.ToString("0.0")
                        </span>

                    </td>

                </tr>
            }

            </tbody>

        </table>

    </div>

</div>