@model UniversityManagement.Core.Models.Student

@{
    ViewData["Title"] = "Edit Student";
}

<div class="card shadow">

    <div class="card-body">

        <h2>Edit Student</h2>

        <form asp-action="Edit">

            <input type="hidden" asp-for="Id"/>

            <div class="mb-3">
                <label>First Name</label>

                <input asp-for="FirstName"
                       class="form-control"/>
            </div>

            <div class="mb-3">
                <label>Last Name</label>

                <input asp-for="LastName"
                       class="form-control"/>
            </div>

            <div class="mb-3">
                <label>Email</label>

                <input asp-for="Email"
                       class="form-control"/>
            </div>

            <button type="submit"
                    class="btn btn-primary">
                Save Changes
            </button>

        </form>

    </div>

</div>