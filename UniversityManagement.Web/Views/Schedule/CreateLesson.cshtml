<div class="card shadow">

    <div class="card-body">

        <h2 class="mb-4">
            Create Lesson
        </h2>

        <form>

            <div class="mb-3">

                <label>Lesson Type</label>

                <select class="form-select">

                    <option>Lecture</option>
                    <option>Seminar</option>
                    <option>Laboratory</option>

                </select>

            </div>

            <div class="mb-3">

                <label>Date</label>

                <input type="datetime-local"
                       class="form-control"/>

            </div>

            <button class="btn btn-primary">
                Create
            </button>

        </form>

    </div>

</div>